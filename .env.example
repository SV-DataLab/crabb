VITE_API_BASE_URL=https://api.crabbahia.com.ar/api

# Endpoints de auth (Laravel Sanctum Bearer token).
VITE_AUTH_LOGIN_ENDPOINT=/auth/login
VITE_AUTH_ME_ENDPOINT=/auth/me
VITE_AUTH_LOGOUT_ENDPOINT=/auth/logout

# Endpoint de busqueda de colegas (opcional durante migracion incremental).
VITE_COLEGAS_SEARCH_ENDPOINT=

# API pública de TallerOK (talleres/:slug y talleres/:slug/disponibilidad),
# usada por la página pública /talleres/:slug/turno.
VITE_TALLEROK_API_URL=https://tallerok-api.crabbahia.com.ar/api
